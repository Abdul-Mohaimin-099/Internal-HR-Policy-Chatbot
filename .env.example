# required
PROJECT_API_KEY=changeme

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=HR Policy Chatbot

# LLM provider keys — Google is required for triage / respond / embeddings
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Flash-Lite primary + ordered fallbacks (tried if primary fails)
TRIAGE_MODEL=gemini-3.1-flash-lite
RESPONSE_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://hr:hr@localhost:5432/hr_chatbot
DATABASE_URL_SYNC=postgresql+psycopg://hr:hr@localhost:5432/hr_chatbot

# Qdrant (cloud or local)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_CLUSTER_ID=
QDRANT_COLLECTION=hr_policy_chunks

# Disable torch.compile for Docling on Windows (avoids needing MSVC cl.exe)
TORCHDYNAMO_DISABLE=1
TORCH_COMPILE_DISABLE=1
TORCHINDUCTOR_DISABLE=1

# optional
PROJECT_NAME=HR Policy Chatbot
VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
API_V1_STR=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
